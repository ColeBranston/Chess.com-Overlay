{
  "manifest_version": 3,
  "name": "Chess Live Hints",
  "version": "2.0.0",
  "description": "Stockfish 19 overlay for chess.com's analysis board and finished games: best moves for both sides, move ratings and a player report.",
  "permissions": ["storage"],
  "host_permissions": ["https://api.chess.com/*", "https://www.chess.com/*"],
  "background": { "service_worker": "background.js" },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "content_scripts": [
    {
      "matches": ["https://www.chess.com/*"],
      "js": ["content.js"],
      "css": ["content.css"]
    },
    {
      "matches": ["https://www.chess.com/*"],
      "js": ["board-reader.js"],
      "world": "MAIN"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["hints.html"],
      "matches": ["https://www.chess.com/*"]
    }
  ]
}
